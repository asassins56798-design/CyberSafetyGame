<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ВНЕШНИЙ ЧЁРНЫЙ КОНТУР + ТЕНЬ СНИЗУ -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1A1A1A" />
        </shape>
    </item>

    <!-- ОСНОВНАЯ ПЛИТКА -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#B0A398"
                android:centerColor="#8D6E63"
                android:endColor="#5D4037"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4E342E" />
        </shape>
    </item>

    <!-- ВЕРХНИЙ СВЕТЛЫЙ БЛИК -->
    <item
        android:left="16dp"
        android:right="16dp"
        android:top="10dp"
        android:bottom="56dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#55FFFFFF" />
        </shape>
    </item>

</layer-list>