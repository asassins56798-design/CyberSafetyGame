<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <!-- ДЕКОРАТИВНОЕ СВЕЧЕНИЕ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/glow_circle"
        android:translationX="150dp"
        android:translationY="-150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ЛОГОТИП-ЩИТ -->
    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="80sp"
        android:layout_marginTop="110dp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЗАГОЛОВОК -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="БЕЗОПАСНО"
        android:textColor="#3E2723"
        android:textSize="42sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:shadowColor="#FFB74D"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:layout_marginTop="20dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РАЗДЕЛИТЕЛЬ -->
    <View
        android:id="@+id/vDivider"
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:background="#E67E22"
        android:layout_marginTop="14dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ПОДЗАГОЛОВОК -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ИГРА О КИБЕРБЕЗОПАСНОСТИ"
        android:textColor="#8D6E63"
        android:textSize="12sp"
        android:letterSpacing="0.35"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/vDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА НАЧАТЬ ИГРУ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewGame"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="НАЧАТЬ ИГРУ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFF8E1"
        android:letterSpacing="0.12"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_wood_primary"
        app:backgroundTint="@null"
        app:elevation="8dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@id/btnStory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА ИСТОРИЯ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStory"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="ИСТОРИЯ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFF8E1"
        android:letterSpacing="0.12"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/btn_wood_secondary"
        app:backgroundTint="@null"
        app:elevation="8dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ВЕРСИЯ -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textColor="#A1887F"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>