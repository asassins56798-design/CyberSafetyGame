<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <!-- GIF МАЛЬЧИКА — на весь экран, нижний слой -->
    <ImageView
        android:id="@+id/ivKid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЗАТЕМНЕНИЕ ПОВЕРХ GIF -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЗАГОЛОВОК SMART BOY -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SMART BOY"
        android:textColor="#FFB74D"
        android:textSize="42sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:gravity="center"
        android:shadowColor="#3E2723"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:layout_marginTop="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:alpha="0"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="30sp"
        app:autoSizeMaxTextSize="42sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РАЗДЕЛИТЕЛЬ -->
    <View
        android:id="@+id/vDivider"
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:background="#FFB74D"
        android:layout_marginTop="14dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ПОДЗАГОЛОВОК — с transformPivot для дыхания от центра -->
    <!-- ПОДЗАГОЛОВОК — pivot устанавливается в Java -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ИГРА О КИБЕРБЕЗОПАСНОСТИ"
        android:textColor="#FFAB91"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.25"
        android:shadowColor="#3E2723"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:layout_marginTop="14dp"
        android:alpha="0"
        app:layout_constraintTop_toBottomOf="@id/vDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА НАЧАТЬ ИГРУ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewGame"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="НАЧАТЬ ИГРУ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFF8E1"
        android:letterSpacing="0.12"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_wood_primary"
        app:backgroundTint="@null"
        app:elevation="8dp"
        android:alpha="0"
        app:layout_constraintBottom_toTopOf="@id/btnStory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА ИСТОРИЯ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStory"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="ИСТОРИЯ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFF8E1"
        android:letterSpacing="0.12"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/btn_wood_secondary"
        app:backgroundTint="@null"
        app:elevation="8dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ВЕРСИЯ -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textColor="#FFF8E1"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>