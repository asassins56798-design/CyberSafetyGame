<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ФОН -->
    <ImageView
        android:id="@+id/ivStoryBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_laptop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЗАТЕМНЕНИЕ -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- СЧЁТЧИК АТАК -->
    <TextView
        android:id="@+id/tvBossProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вопрос 1/5"
        android:textColor="#3E2723"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/badge_bg"
        android:layout_marginTop="28dp"
        android:layout_marginStart="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- АТАКА БОССА -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBossAttack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F2FFF8E1"
        app:layout_constraintTop_toBottomOf="@id/tvBossProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvBossAttack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="👹 БОСС: «Текст атаки»"
            android:textColor="#3E2723"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- КАРТОЧКА ВОПРОСА -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStoryQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#F2FFF8E1"
        app:layout_constraintBottom_toTopOf="@id/btnStoryOption1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStoryQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="22dp"
            android:text="Как ты ответишь?"
            android:textColor="#3E2723"
            android:textSize="18sp"
            android:lineSpacingExtra="5dp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- КНОПКИ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStoryOption1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Вариант 1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_answer_bg"
        app:backgroundTint="@null"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/btnStoryOption2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStoryOption2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Вариант 2"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_answer_bg"
        app:backgroundTint="@null"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/btnStoryOption3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStoryOption3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Вариант 3"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:padding="14dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/btn_answer_bg"
        app:backgroundTint="@null"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>