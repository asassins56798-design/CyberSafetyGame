<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <!-- ДЕКОРАТИВНОЕ СВЕЧЕНИЕ (янтарное) -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/glow_circle"
        android:translationX="150dp"
        android:translationY="-150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- МЕДАЛЬ / КУБОК -->
    <TextView
        android:id="@+id/tvMedal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆"
        android:textSize="120sp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЗАГОЛОВОК -->
    <TextView
        android:id="@+id/tvWinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ПОБЕДА!"
        android:textColor="#3E2723"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:shadowColor="#FFB74D"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvMedal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РАЗДЕЛИТЕЛЬ -->
    <View
        android:id="@+id/vWinDivider"
        android:layout_width="80dp"
        android:layout_height="4dp"
        android:background="#E67E22"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvWinTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- РЕЗУЛЬТАТ -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Правильных ответов: 10/10"
        android:textColor="#3E2723"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/vWinDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ПОЗДРАВЛЕНИЕ -->
    <TextView
        android:id="@+id/tvCongrats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ты стал мастером кибербезопасности!\nТеперь открой Историю и передай знания дальше."
        android:textColor="#5D3A1A"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvScore"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА ИГРАТЬ ЕЩЁ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlayAgain"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="ИГРАТЬ ЕЩЁ"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_primary_bg"
        app:backgroundTint="@null"
        app:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/btnOpenStory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА ОТКРЫТЬ ИСТОРИЮ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenStory"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:text="📖  ОТКРЫТЬ ИСТОРИЮ"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:letterSpacing="0.1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_secondary_bg"
        app:backgroundTint="@null"
        app:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/btnBackMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА В МЕНЮ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackMenu"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="В МЕНЮ"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:letterSpacing="0.1"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/btn_secondary_bg"
        app:backgroundTint="@null"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>